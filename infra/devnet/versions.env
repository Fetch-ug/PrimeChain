# Pinned stack versions for the Phase 1 devnet.
# Sourced from upstream release metadata on 2026-10-24 (see README.md).

# op-node: image published in the v1.19.11 release notes.
OP_NODE_TAG="v1.19.11"
OP_NODE_IMAGE="us-docker.pkg.dev/oplabs-tools-artifacts/images/op-node:v1.19.11"

# op-geth is versioned independently. RESOLVE BEFORE FIRST BOOT:
#   https://api.github.com/repos/ethereum-optimism/op-geth/releases/latest
# Do not reuse OP_NODE_TAG here.
OP_GETH_TAG="TODO-resolve-from-op-geth-releases"
OP_GETH_IMAGE="us-docker.pkg.dev/oplabs-tools-artifacts/images/op-geth:${OP_GETH_TAG}"

# Upstream monorepo checkout used for devnet recipes (just, not make).
OPTIMISM_REPO="https://github.com/ethereum-optimism/optimism.git"
OPTIMISM_TAG="op-node/v1.19.11"

# Chain identity is provisional until genesis is generated in Phase 1B.
# Must not collide with an existing public chain ID; verify against
# https://chainlist.org before testnet.
CHAIN_ID="TODO-assign"
L2_BLOCK_TIME_SECONDS="2"

# Local endpoints
L1_RPC_URL="http://localhost:8545"
L2_RPC_URL="http://localhost:9545"
L2_REPLICA_RPC_URLS="http://localhost:9546 http://localhost:9547"
